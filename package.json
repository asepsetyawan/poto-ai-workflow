{
  "name": "ai-workflow",
  "version": "0.1.0",
  "description": "Monorepo: Express API + React frontend with an AI-native development workflow",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run dev:backend",
    "dev:backend": "npm run dev --workspace=@ai-workflow/backend",
    "dev:frontend": "npm run dev --workspace=@ai-workflow/frontend",
    "dev:all": "npm run dev:backend & npm run dev:frontend",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=@ai-workflow/backend",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=@ai-workflow/backend",
    "test:watch": "npm run test:watch --workspace=@ai-workflow/backend",
    "test:coverage": "npm run test:coverage --workspace=@ai-workflow/backend",
    "db:generate": "npm run db:generate --workspace=@ai-workflow/backend",
    "db:migrate": "npm run db:migrate --workspace=@ai-workflow/backend",
    "db:studio": "npm run db:studio --workspace=@ai-workflow/backend",
    "db:seed": "npm run db:seed --workspace=@ai-workflow/backend",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.18.1"
  },
  "lint-staged": {
    "apps/backend/**/*.{ts,js}": [
      "npm run lint:fix --workspace=@ai-workflow/backend --",
      "prettier --write"
    ],
    "apps/frontend/**/*.{ts,tsx,js}": [
      "npm run lint:fix --workspace=@ai-workflow/frontend --",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
