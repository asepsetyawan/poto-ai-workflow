# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000

# Local dev matches docker-compose.yml. Use a separate DB/user in staging & prod.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_workflow

# Generate a strong secret, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long
JWT_EXPIRES_IN=1d

LOG_LEVEL=info
CORS_ORIGIN=*
